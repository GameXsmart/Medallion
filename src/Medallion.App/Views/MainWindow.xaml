<Window x:Class="Medallion.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Medallion" Height="740" Width="1080" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Column="0" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource StrokeSoft}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,26,0,26">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Medallion" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="INSTANT REPLAY" Style="{StaticResource LabelCaps}" FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE7F4;"
                                     Content="Dashboard" IsChecked="True" GroupName="Nav"
                                     Checked="OnNavChecked" />
                        <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" Tag="&#xE8B2;"
                                     Content="Clips" GroupName="Nav" Checked="OnNavChecked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                     Content="Settings" GroupName="Nav" Checked="OnNavChecked" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="16,0,16,18" Padding="13,11" CornerRadius="10"
                            Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding StateBrush}" />
                                <TextBlock Text="{Binding StateText}" Margin="8,0,0,0" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{Binding StateBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding BufferLabel}" Style="{StaticResource BodyText}"
                                       FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ Content ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Margin="26,0,0,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextDim}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize"
                                ToolTip="Minimise" />
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize"
                                ToolTip="Maximise" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose"
                                ToolTip="Close to tray" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" />
            </Grid>
        </Grid>
    </Border>
</Window>
