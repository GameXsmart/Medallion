<UserControl x:Class="Medallion.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ClipAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,6,16">
            <StackPanel>
                <TextBlock Text="Clips" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox Style="{StaticResource Field}" Width="170" Height="36" Margin="0,0,8,0"
                         Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter clips by name" />
                <ComboBox Style="{StaticResource Dropdown}" Width="150" Margin="0,0,8,0"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding Sort, Mode=TwoWay}" />
                <Button Style="{StaticResource GhostButton}" Content="Open folder"
                        Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource GhostButton}" Content="Refresh"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource Card}" Padding="40" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                <TextBlock Text="No clips yet" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Text="Leave Replay running, play something, and press your hotkey.&#x0a;The last 30 seconds land here." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding Clips}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Width="150" Height="84" CornerRadius="8"
                                        Background="{DynamicResource Bg3}" ClipToBounds="True" Cursor="Hand"
                                        MouseLeftButtonUp="OnThumbnailClick">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        <Border Background="#55000000">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.9" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" Margin="16,2,0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Name, or inline rename box -->
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="14.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBox Grid.Row="0" Style="{StaticResource Field}" Padding="8,5"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             KeyDown="OnRenameKeyDown" Loaded="OnRenameBoxLoaded" />

                                    <TextBlock Grid.Row="1" Text="{Binding Meta}" Style="{StaticResource BodyText}"
                                               FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                Margin="0,10,0,0">
                                        <Button Style="{StaticResource ClipAction}" Content="Play"
                                                Command="{Binding PlayCommand}" />
                                        <Button Style="{StaticResource ClipAction}" Content="Show in folder"
                                                Command="{Binding RevealCommand}" />
                                        <Button Style="{StaticResource ClipAction}" Content="Rename"
                                                Command="{Binding BeginRenameCommand}" />
                                        <Button Style="{StaticResource ClipAction}" Content="Delete"
                                                Foreground="{DynamicResource Danger}"
                                                Click="OnDeleteClick" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
