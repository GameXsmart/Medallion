<UserControl x:Class="Medallion.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Trim handle: a grabbable bar at each end of the selection -->
        <Style x:Key="TrimHandle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="6" CornerRadius="3"
                                    Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Bar" Property="Width" Value="8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="{DynamicResource Bg3}" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{StaticResource AccentGradient}" RadiusX="2" RadiusY="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="26,10,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0" Margin="0,0,6,14">
            <StackPanel>
                <TextBlock Text="Edit clip" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding ClipName}" Style="{StaticResource BodyText}"
                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520"
                           HorizontalAlignment="Left" />
            </StackPanel>
            <Button Style="{StaticResource GhostButton}" Content="Back to clips"
                    Click="OnBack" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- ============ Preview ============ -->
        <Border Grid.Row="1" CornerRadius="12" Background="Black" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1" ClipToBounds="True" Height="360">
            <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              ScrubbingEnabled="True" Stretch="Uniform"
                              MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded"
                              MediaFailed="OnMediaFailed" MouseLeftButtonUp="OnPreviewClick" />

                <TextBlock x:Name="PreviewError" Visibility="Collapsed" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"
                           TextAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource TextDim}" />
            </Grid>
        </Border>

        <!-- ============ Transport + timeline ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Padding="12,7" FontSize="13"
                                FontFamily="Segoe MDL2 Assets" Content="{Binding PlayPauseGlyph}"
                                Command="{Binding PlayPauseCommand}" ToolTip="Play / pause (Space)" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource Text}">
                            <Run Text="{Binding PositionLabel, Mode=OneWay}" />
                            <Run Text=" / " Foreground="{DynamicResource TextFaint}" />
                            <Run Text="{Binding DurationLabel, Mode=OneWay}"
                                 Foreground="{DynamicResource TextDim}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectionLabel}" Style="{StaticResource BodyText}"
                               FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Timeline: click to seek, drag the ends to trim -->
                <Canvas x:Name="Timeline" Height="54" Margin="0,10,0,0" Background="Transparent"
                        SizeChanged="OnTimelineSizeChanged" MouseLeftButtonDown="OnTimelineClick">
                    <Border x:Name="Track" Height="34" Canvas.Top="10" CornerRadius="6"
                            Background="{DynamicResource Bg3}" />
                    <Border x:Name="Selection" Height="34" Canvas.Top="10" CornerRadius="6"
                            Background="#3D7B5CFF" BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1" />
                    <Rectangle x:Name="Playhead" Width="2" Height="46" Canvas.Top="4"
                               Fill="{DynamicResource Live}" />
                    <Thumb x:Name="InHandle" Height="46" Canvas.Top="4"
                           Style="{StaticResource TrimHandle}" DragDelta="OnInDrag"
                           ToolTip="Drag to set the start" />
                    <Thumb x:Name="OutHandle" Height="46" Canvas.Top="4"
                           Style="{StaticResource TrimHandle}" DragDelta="OnOutDrag"
                           ToolTip="Drag to set the end" />
                </Canvas>

                <Grid Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Set start"
                                Padding="11,6" FontSize="11.5" Margin="0,0,7,0"
                                Command="{Binding SetInCommand}" ToolTip="Trim the start to the playhead (I)" />
                        <Button Style="{StaticResource GhostButton}" Content="Set end"
                                Padding="11,6" FontSize="11.5" Margin="0,0,7,0"
                                Command="{Binding SetOutCommand}" ToolTip="Trim the end to the playhead (O)" />
                        <Button Style="{StaticResource GhostButton}" Content="Reset"
                                Padding="11,6" FontSize="11.5"
                                Command="{Binding ResetTrimCommand}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource BodyText}" FontSize="11.5">
                        <Run Text="{Binding StartLabel, Mode=OneWay}" Foreground="{DynamicResource Text}" />
                        <Run Text="  →  " />
                        <Run Text="{Binding EndLabel, Mode=OneWay}" Foreground="{DynamicResource Text}" />
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ Options + export ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SPEED" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource Dropdown}" ItemsSource="{Binding SpeedOptions}"
                                  SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}"
                                  IsEnabled="{Binding CanChangeQuality}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RESOLUTION" Style="{StaticResource LabelCaps}" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource Dropdown}" ItemsSource="{Binding ResolutionOptions}"
                                  SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                  IsEnabled="{Binding CanChangeQuality}" />
                    </StackPanel>
                </Grid>

                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Remove audio"
                          IsChecked="{Binding MuteAudio, Mode=TwoWay}" Margin="0,14,0,0" />
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          Content="Lossless — instant, but the start snaps back to a keyframe (up to ~2s earlier)"
                          IsChecked="{Binding Lossless, Mode=TwoWay}" Margin="0,13,0,0" />
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Save over the original clip"
                          IsChecked="{Binding ReplaceOriginal, Mode=TwoWay}" Margin="0,13,0,0" />

                <Border Height="1" Background="{DynamicResource StrokeSoft}" Margin="0,16,0,14" />

                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OUTPUT" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding OutputSummary}" Style="{StaticResource ValueText}"
                                   FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel"
                                Command="{Binding CancelExportCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource PrimaryButton}" Padding="22,11"
                                Content="{Binding ExportButtonLabel}" Command="{Binding ExportCommand}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}"
                                   FontSize="11.5" />
                        <TextBlock Text="{Binding ExportPercentLabel}" Style="{StaticResource BodyText}"
                                   FontSize="11.5" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ExportBar}"
                                 Value="{Binding ExportProgress, Mode=OneWay}" />
                </StackPanel>

                <!-- The same message, shown only once the export has finished -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasStatus}" Value="True" />
                                        <Condition Binding="{Binding IsExporting}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
