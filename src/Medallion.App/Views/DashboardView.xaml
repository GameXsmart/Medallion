<UserControl x:Class="Medallion.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Buffer fill bar -->
        <Style x:Key="BufferBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{DynamicResource Bg3}" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{StaticResource LiveGradient}" RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info tile -->
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,10,20,26">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- ================= Status hero ================= -->
            <Border Style="{StaticResource Card}" Padding="24,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="{Binding StateBrush}" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25" Duration="0:0:1.1"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{Binding StateText}" Margin="11,0,0,0"
                                       FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                                       Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StateDetail}" Style="{StaticResource BodyText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource GhostButton}"
                            Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}"
                            VerticalAlignment="Top" />

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock Text="REPLAY BUFFER" Style="{StaticResource LabelCaps}" />
                            <TextBlock Text="{Binding BufferLabel}" Style="{StaticResource LabelCaps}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource TextDim}" />
                        </Grid>

                        <ProgressBar Grid.Row="1" Style="{StaticResource BufferBar}"
                                     Value="{Binding BufferFraction, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Warning ================= -->
            <Border Margin="0,12,0,0" CornerRadius="10" Padding="14,11"
                    Background="#1AFFB454" BorderBrush="#40FFB454" BorderThickness="1"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource Warn}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Warning}" Margin="10,0,0,0" TextWrapping="Wrap"
                               FontSize="12" Foreground="#FFE7D3B0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ================= Last clip ================= -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14"
                    Visibility="{Binding HasLastClip, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="LAST CLIP" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding LastClipName}" Style="{StaticResource ValueText}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding LastClipMeta}" Style="{StaticResource BodyText}"
                                   FontSize="11.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Play"
                                Command="{Binding PlayLastCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Edit"
                                Click="OnEditLastClip" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Show in folder"
                                Command="{Binding RevealLastCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Tiles ================= -->
            <Grid Margin="0,12,-12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="CAPTURE" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="ENCODER" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding EncoderLabel}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="RESOLUTION" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding ResolutionLabel}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="FPS  (ACTUAL / TARGET)" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding FpsLabel}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="AUDIO" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding AudioLabel}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}" Cursor="Hand"
                        MouseLeftButtonUp="OnOpenFolder" ToolTip="{Binding SaveLocation}">
                    <StackPanel>
                        <TextBlock Text="SAVE LOCATION" Style="{StaticResource LabelCaps}" />
                        <TextBlock Text="{Binding SaveLocation}" Style="{StaticResource ValueText}"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= Save button ================= -->
            <Button Style="{StaticResource PrimaryButton}" Height="66" Margin="0,10,0,0"
                    Command="{Binding SaveClipCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding SaveButtonText}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Style="{StaticResource BodyText}" FontSize="11.5" Margin="0,12,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}"
                       Text="The hotkey works anywhere in Windows, including while a game is focused." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
